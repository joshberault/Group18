# Copy to .env.local and fill in values from Supabase Dashboard → Project Settings → API
# Project ref for this app: yvsaodoslmfoqcyqvyqd
# URL: Project URL (https://<ref>.supabase.co)
# Key: publishable / anon key (either variable name works)

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Optional alias (same value as publishable key). Older local setups often use this name.
# NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Required for full pipeline seed (matters, time entries, invoices). Never commit.
# SUPABASE_SERVICE_ROLE_KEY=
# Or database password for direct SQL: SUPABASE_DB_PASSWORD=
